{
  "compilerOptions": {
    "target": "es2020",
    // Type-only: WeakRef (used by tests/collectability.test.ts) is an ES2021 lib
    // type. Emitted output is still governed by target.
    "lib": ["ES2021"],
    "module": "commonjs",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "**/*.test.ts"]
}
