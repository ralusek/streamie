{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    // Override the build's lib to drop DOM: these tests cover the core and the
    // node bridges, and pinning them to ES2021 is what proves the core needs no
    // web-stream type environment. The web bridges' type tests, which do need the
    // WHATWG globals, run separately under tsconfig.dom-type-tests.json.
    "lib": ["ES2021"]
  },
  "include": [
    "test/**/*.type-test.ts",
    "tests/**/*.type-test.ts"
  ],
  "exclude": [
    "tests/streams-web.type-test.ts"
  ]
}
