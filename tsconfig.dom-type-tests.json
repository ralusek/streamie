{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    // The 'streamie/web' entry types against the real WHATWG stream globals, so its
    // type tests need the DOM lib. The core type tests (tsconfig.type-tests.json) run
    // without DOM on purpose, to prove the core needs no web-stream type environment;
    // this is the one config that brings the globals in.
    "lib": ["ES2021", "DOM"]
  },
  "include": ["tests/streams-web.type-test.ts"]
}
